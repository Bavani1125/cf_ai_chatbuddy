{
  "name": "cf-ai-chatbuddy",
  "main": "src/index.js",
  "compatibility_date": "2024-10-01",

 
  "ai": { "binding": "AI" },

  
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_DO", "class_name": "ChatSession" }
    ]
  },


  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatSession"]
    }
  ],

  
  "assets": { "directory": "public" }
}
